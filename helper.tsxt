// In your main page components.navbar:
navbar: {
  uiSchema: {
    logo: {
      "ui:widget": "text",
      "ui:content": "🍵 Chiyaz",
      "ui:styles": {
        fontSize: "28px",
        fontWeight: "800",
        fontFamily: "'Playfair Display', serif",
        background: "linear-gradient(135deg, #8B4513 0%, #D2691E 100%)",
        WebkitBackgroundClip: "text",
        WebkitTextFillColor: "transparent",
        cursor: "pointer",
      },
    },
    themeToggle: {
      "ui:widget": "toggle",
      "ui:size": "medium",
      "ui:onChange": "toggleTheme",
      "ui:styles": {
        marginLeft: "auto",
        marginRight: "20px",
      },
    },
    links: {
      "ui:widget": "navLinks",
      "ui:theme": "dark",  // Changed to dark for cream text
      "ui:links": [
        { label: "Login", action: "navigateToPage", actionParams: { url: "/chiyaz/login" } },
        { label: "Sign Up", action: "navigateToPage", actionParams: { url: "/chiyaz/signup" } },
      ],
    },
  },
  styles: {
    // ✅ TEA/COFFEE THEMED NAVBAR
    background: "rgba(44, 24, 16, 0.95)",  // Dark brown coffee color
    backdropFilter: "blur(20px) saturate(180%)",
    borderBottom: "2px solid rgba(212, 185, 150, 0.3)",  // Gold/cream border
    padding: "18px 40px",
    position: "fixed",
    width: "100%",
    zIndex: "1000",
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center",
    boxShadow: "0 4px 20px rgba(139, 69, 19, 0.2)",
    height: "70px",
  },
}

// For dashboard sidebar (pages.dashboard.components.sidebar):
sidebar: {
  uiSchema: {
    menuHeading: {
      "ui:widget": "heading",
      "ui:text": "🍵 Menu",
      "ui:level": "h3",
      "ui:styles": {
        marginBottom: "24px",
        fontSize: "1.3rem",
        color: "#F5E9D9",  // Cream color
        padding: "0 12px",
        fontFamily: "'Playfair Display', serif",
        textShadow: "0 2px 8px rgba(0,0,0,0.3)",
      },
    },
    menuContainer: {
      "ui:widget": "container",
      "ui:direction": "column",
      "ui:gap": "10px",
      "ui:children": [
        {
          "ui:widget": "button",
          "ui:label": "🏠 Dashboard",
          "ui:action": "navigateToPage",
          "ui:actionParams": { url: "/chiyaz/dashboard" },
          "ui:styles": {
            width: "100%",
            padding: "14px 20px",
            background: "rgba(212, 185, 150, 0.2)",  // Active: cream highlight
            color: "#F5E9D9",
            border: "1px solid rgba(212, 185, 150, 0.3)",
            borderRadius: "12px",
            fontSize: "15px",
            fontWeight: "600",
            textAlign: "left",
            boxShadow: "0 2px 8px rgba(139, 69, 19, 0.2)",
            transition: "all 0.3s ease",
          },
        },
        {
          "ui:widget": "button",
          "ui:label": "🛒 My Orders",
          "ui:styles": {
            width: "100%",
            padding: "14px 20px",
            background: "transparent",
            color: "rgba(245, 233, 217, 0.8)",  // Softer cream
            border: "1px solid transparent",
            borderRadius: "12px",
            fontSize: "15px",
            fontWeight: "500",
            textAlign: "left",
            transition: "all 0.3s ease",
          },
        },
        // ... other menu items with same styling
      ],
    },
  },
  styles: {
    width: "280px",
    background: "rgba(44, 24, 16, 0.95)",  // Dark brown coffee
    backdropFilter: "blur(15px)",
    padding: "90px 20px 30px",
    minHeight: "calc(100vh - 70px)",
    borderRight: "2px solid rgba(212, 185, 150, 0.2)",
    position: "fixed",
    top: "70px",
    left: "0",
    boxShadow: "4px 0 20px rgba(0, 0, 0, 0.3)",
  },
}